new rl(`rho:registry:lookup`), systemVaultCh in {
              rl!(`rho:vault:system`, *systemVaultCh) |
              for (@(_, SystemVault) <- systemVaultCh) {
                new systemVaultInitCh in {
                  @SystemVault!("init", *systemVaultInitCh) |
                  for (TreeHashMap, @vaultMap, initVault, initContinue <- systemVaultInitCh) {
                    match [("1111AtahZeefej4tvVR6ti9TJtv8yxLebT31SCEVDCKMNikBk5r3g", 500000000000000000000000000n), ("111127RX5ZgiAdRaQy4AWy57RdvAAckdELReEBxzvWYVvdnR32PiHA", 500000000000000000000000000n), ("111129p33f7vaRrpLqK8Nr35Y2aacAjrR5pd6PCzqcdrMuPHzymczH", 500000000000000000000000000n), ("1111LAd2PWaHsw84gxarNx99YVK2aZhCThhrPsWTV7cs1BPcvHftP", 5000000000000000000000000000n), ("1111ocWgUJb5QqnYCvKiPtzcmMyfvD3gS5Eg84NtaLkUtRfw3TDS8", 500000000000000000000000000n), ("11112gdfJXQ82j8eem4akeY2b7duwAuPGGVNzPfY2yczPXJ5xGHqNA", 50000000000000000000000000n), ("111123LDiag3eLyDPKvndxZiAB6bfTuKL6kLezRJYNAwYwUnz6DN5r", 50000000000000000000000000n), ("11112e47mx75Rw3J1hMgFekMELzyYU6T8GgCBB4D1P8LNVuBFjcUiS", 50000000000000000000000000n), ("1111ujPma22XaFAfUd9xiH8rVaFfUN5HQU8Vr8vdXATP4Lmspz9JZ", 543219876000000000000000000n), ("11112pVB29dbbJ3UvhXFgYuF5JULJPEGouZ5TYWXk9VxREF7o5Cqgm", 54321987600000000000000000n), ("1111J99D2swwtmon5oEtE3w23BG2iVRF8kSc1pjNHoiZLjWrZUzPA", 543219876000000000000000000n), ("1111DqBSdrAiZ7pCeGyGqDKbgzoVKVEwz9m9EiQpwruLLX5ZVLqFN", 543219876000000000000000000n), ("11112v5CBawbU1VREAJVXQ1QE52H19WLfSfZQEUjPzA57rKLvDGH7j", 54321987600000000000000000n), ("111125xD9xnpVyWyMmgU78ZfjKq1Zd4PCLs1RF1ytjTccqw4fjf315", 12345678900000000000000000n), ("11112tY2Pwj2tWP5uNk3tJEBenW44Ctroa2wvaJRMAcWfjnD6euQMJ", 1234567890000000000000000n), ("11112TYiiUouKbfpwkkp47QRyZPhXawXgEpzbLgka2aRPe5h7f5y17", 12345678900000000000000000n), ("111125xD9xnpVyWyMmgU78ZfjKq1Zd4PCLs1RF1ytjTccqw4fjf315", 12345678900000000000000000n), ("1111KSYFMEH8CszpYahzmJCZEedJwaXCyZNA9JxhwWNcuD8UHq49G", 123456789000000000000000000n), ("1111EjdAxnKb5zKUc8ikuxfdi3kwSGH7BJCHKWjnVzfAF3SjCBvjh", 500000000000000000000000000n), ("1111jyBBTGUTqnvcd7ggu8YdaZjhi4yTkFksgnMAKWmZ1HoTzDzk2", 500000000000000000000000000n), ("1111La6tHaCtGjRiv4wkffbTAAjGyMsVhzSUNzQxH1jjZH9jtEi3M", 500000000000000000000000000n)] {
                      vaults => {
                        new iter in {
                          contract iter(@[(addr, initialBalance) ... tail]) = {
                          iter!(tail) |
                          new vault, setDoneCh in {
                            initVault!(*vault, addr, initialBalance) |
                            TreeHashMap!("set", vaultMap, addr, *vault, *setDoneCh) |
                            for (_ <- setDoneCh) { Nil }
                          }
                      } |
                      iter!(vaults)
                    }
                  }
                }
              }
            }
          }
        }
