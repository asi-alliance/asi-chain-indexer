# ASI Chain Indexer Environment Configuration
# Copy this file to .env and fill in your values (see .env.example for every option)

# Node Configuration
NODE_HOST=localhost
GRPC_PORT=40402
HTTP_PORT=40403

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/asi_indexer
DATABASE_POOL_SIZE=10

# Hasura Configuration
# Base URL; scripts/full-init-hasura.sh derives the metadata endpoint from it
HASURA_BASE=http://localhost:8080
HASURA_ADMIN_SECRET=your_hasura_admin_secret_here

# Indexing Configuration
SYNC_INTERVAL=5
BATCH_SIZE=100
START_FROM_BLOCK=0

# Monitoring
MONITORING_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
