# ASI Chain Indexer Environment Configuration
# Copy this file to .env and fill in your values (see .env.example for every option)
# These values match docker-compose.yml.

# Node Configuration
NODE_HOST=localhost
# Observer ports of the ASI deployment; a standard node uses 40401/40403
GRPC_PORT=40452
HTTP_PORT=40453

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://indexer:indexer_pass@postgres:5432/asichain
DATABASE_POOL_SIZE=20

# Hasura Configuration
# Base URL; scripts/full-init-hasura.sh derives the metadata endpoint from it
HASURA_BASE=http://localhost:8080
HASURA_ADMIN_SECRET=your_hasura_admin_secret_here

# Indexing Configuration
SYNC_INTERVAL=5
BATCH_SIZE=50
START_FROM_BLOCK=0

# Native token precision; must match the node's native token metadata
NATIVE_TOKEN_DECIMALS=8

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
