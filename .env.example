# ASI-Chain Indexer Environment Configuration

# Node Configuration

NODE_HOST=localhost
GRPC_PORT=40452 # Internal gRPC API
HTTP_PORT=40453 # Node HTTP API (/api/validators, /api/epoch)
NODE_TIMEOUT=30
# Node protobuf profile: classic or uint256 (node with uint256 monetary fields)
NODE_PROTOCOL_PROFILE=classic
GRPC_MAX_RECEIVE_MESSAGE_BYTES=67108864

# Database Configuration
# Matches the PostgreSQL service in docker-compose.yml
DATABASE_URL=postgresql://indexer:indexer_pass@postgres:5432/asichain
DATABASE_POOL_SIZE=20

# Sync Settings
SYNC_INTERVAL=5
BATCH_SIZE=50
START_FROM_BLOCK=0

# Alerts (Mattermost incoming webhook)
ALERTS_ENABLED=false
# Required when ALERTS_ENABLED=true
MATTERMOST_WEBHOOK_URL=
# Optional: overrides the webhook's default channel
MATTERMOST_CHANNEL=
MATTERMOST_USERNAME=asi-indexer
# Repeat alerts of the same kind inside this window are collapsed into a suppressed count
ALERT_THROTTLE_SEC=3600
ALERT_TIMEOUT_SEC=5
# Longest error / context value posted to the channel; longer text is cut off
ALERT_MAX_TEXT_LEN=300
# Timeout for each read/write of the persisted throttle state (indexer_state)
ALERT_STORE_TIMEOUT_SEC=1.0
# Environment label shown in the alert title, e.g. internal-dev or devnet
ALERT_ENVIRONMENT=unknown
# Consecutive failed sync cycles before the loop is considered stalled
SYNC_STALL_THRESHOLD=3
# Consecutive sync cycles the node may return no data (no last finalized block,
# or no blocks for a non-empty range) before a node-unreachable alert
NODE_UNREACHABLE_CYCLES=3
# Lag depth (in blocks) that, held for LAG_ALERT_CYCLES without net progress, is
# treated as falling behind rather than a backlog being worked through
LAG_ALERT_BLOCKS=500
# Cycles of sustained lag deeper than LAG_ALERT_BLOCKS before alerting
LAG_ALERT_CYCLES=60
# Lag counts as recovering when the recent half of the window is at most this
# fraction of the older half; lower values demand faster catch-up
LAG_RECOVERY_RATIO=0.9
# Cycles the sync cursor may sit at the same height, retrying a failing block,
# before that stops looking transient
CURSOR_STUCK_CYCLES=3

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Features
ENABLE_ASI_TRANSFER_EXTRACTION=true
ENABLE_PENDING_DEPLOYS_SYNC=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true

# Hasura Configuration
# Compose passes the secret to Hasura; scripts/full-init-hasura.sh uses it to
# write metadata. The indexer itself does not use it.
HASURA_ADMIN_SECRET=replace-with-a-long-random-secret
# scripts/full-init-hasura.sh derives its endpoints from HASURA_BASE.
HASURA_BASE=http://localhost:8080
# Optional overrides for scripts/full-init-hasura.sh
# HASURA_ENDPOINT=http://localhost:8080/v1/metadata
# HASURA_GRAPHQL=http://localhost:8080/v1/graphql
# HASURA_SQL=http://localhost:8080/v2/query
# GHC runtime options for the Hasura container (Compose default: -maxN8).
# HASURA_GHCRTS=-maxN8

# Python settings that docker-compose.yml does not pass to the indexer
# container. They apply when you run python -m src.main directly or add them to
# the service environment.
# DATABASE_POOL_TIMEOUT=10
# DELAY_BEFORE_NODE=0.02
# FAULT_TOLERANCE_THRESHOLD=0.67
# MONITORING_PORT=9090
# HEALTH_CHECK_INTERVAL=60

# Must match node native token metadata; existing networks use 8.
NATIVE_TOKEN_DECIMALS=8
